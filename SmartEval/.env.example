# PostgreSQL is required for application persistence. SQLite is only used by automated tests.
DATABASE_URL=postgresql+psycopg://smarteval:postgres@localhost:5432/smarteval
DATABASE_ECHO=false
PERSISTENCE_FAILURE_IS_ERROR=true
RETAIN_EVALUATION_CONTENT=true

# SmartHTR and SmartEval share one Python runtime (including Google Colab).
SMARTHR_PROVIDER=local

API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_SIZE_MB=20
TEMP_DIRECTORY=temp
KEEP_INPUT_FILES=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
