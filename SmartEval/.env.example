# PostgreSQL is required for application persistence. SQLite is only used by automated tests.
DATABASE_URL=postgresql+psycopg://smarteval:postgres@localhost:5432/smarteval
DATABASE_ECHO=false
PERSISTENCE_FAILURE_IS_ERROR=true
RETAIN_EVALUATION_CONTENT=true

# SmartHTR and SmartEval share one Python runtime (including Google Colab).
SMARTHR_PROVIDER=local
OCR_PROVIDER=chrome

# Required only when OCR_PROVIDER=chrome. Never commit real credentials.
ILOVEPDF_PUBLIC_KEY=your-public-key
ILOVEPDF_SECRET_KEY=your-secret-key
ILOVEPDF_REGION=in
ILOVEPDF_TIMEOUT=120

API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_SIZE_MB=20
TEMP_DIRECTORY=temp
KEEP_INPUT_FILES=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Visible local Windows OCR; avoid mouse/keyboard use during copying.
CHROME_OCR_EXECUTABLE=
CHROME_OCR_WINDOW_MODE=simple
CHROME_OCR_INITIAL_WAIT_SECONDS=10
CHROME_OCR_CLICK_X=700
CHROME_OCR_CLICK_Y=500
CHROME_OCR_MAX_ATTEMPTS=5
CHROME_OCR_RETRY_DELAY_SECONDS=2
CHROME_OCR_STABLE_ATTEMPTS=5
CHROME_OCR_MIN_CHARACTERS=20
